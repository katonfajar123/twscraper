# ============================================================
# twscraper - Environment Variables
# Salin file ini menjadi .env lalu isi dengan nilai asli Anda
# ============================================================

# (Opsional) Path ke file database SQLite akun
# Default: accounts.db di direktori saat ini
# TWS_DB=accounts.db

# (Opsional) Proxy global untuk semua akun
# TWS_PROXY=http://user:pass@host:port

# (Opsional) Backend HTTP: httpx (default) atau curl
# TWS_HTTP_BACKEND=httpx

# (Opsional) Timeout menunggu kode verifikasi email (detik)
# TWS_WAIT_EMAIL_CODE=30

# (Opsional) Raise error jika tidak ada akun tersedia, alih-alih menunggu
# TWS_RAISE_WHEN_NO_ACCOUNT=false

# (Opsional) Level log: DEBUG, INFO, WARNING, ERROR
# TWS_LOG_LEVEL=INFO

# (Opsional) Nonaktifkan telemetry anonim
# TWS_TELEMETRY=0
